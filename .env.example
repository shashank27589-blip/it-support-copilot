APP_NAME=IT Support Copilot
APP_ENV=development

# Required for chat and embeddings
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Required for the private knowledge base and web fallback
PINECONE_API_KEY=
PINECONE_INDEX_NAME=it-support-copilot
PINECONE_NAMESPACE=company-it-kb
TAVILY_API_KEY=

# Set a long random value to enable document uploads
ADMIN_API_KEY=
TOP_K=4
MAX_RETRIES=1
